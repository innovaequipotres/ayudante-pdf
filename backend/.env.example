# Proveedor de análisis semántico con IA: gemini (por defecto) u openrouter
AI_PROVIDER=gemini

# Clave de API de Google Gemini
GEMINI_API_KEY=

# Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-2.0-flash

# Clave de API de OpenRouter (solo si AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Modelo de OpenRouter. No hay valor por defecto: elegí uno en
# https://openrouter.ai/models filtrando por structured_outputs. Los modelos
# :free tienen límites de uso variables; verificá la política de datos del
# modelo antes de usarlo con material de estudiantes.
OPENROUTER_MODEL=

# Nombre de la aplicación (header X-Title hacia OpenRouter)
OPENROUTER_APP_NAME=Ayudante PDF

# URL de referencia opcional (header HTTP-Referer hacia OpenRouter)
OPENROUTER_REFERER=

# Timeout en segundos para las llamadas a OpenRouter
OPENROUTER_TIMEOUT_SECONDS=30

# Tamaño máximo permitido para archivos PDF (en MB)
MAX_UPLOAD_MB=25

# Orígenes permitidos para CORS, separados por coma.
# Incluye el propio backend para poder probar /docs, y el frontend local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
