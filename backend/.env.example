# Clave de API de Google Gemini
GEMINI_API_KEY=

# Modelo de Gemini a utilizar
GEMINI_MODEL=gemini-2.0-flash

# Tamaño máximo permitido para archivos PDF (en MB)
MAX_UPLOAD_MB=25

# Orígenes permitidos para CORS, separados por coma.
# Incluye el propio backend para poder probar /docs, y el frontend local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
